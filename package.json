{
  "name": "@whitenight_5/web-assistant",
  "version": "0.0.15",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/web-assistant.umd.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",

    "build:core": "vite build --mode core",
    "build:dist": "vite build --mode fab && vite build --mode core",
    "prepublishOnly": "pnpm build:dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "patch-package"
  },

# Dify API 配置
# 从 Dify 应用设置页面获取
VITE_DIFY_API_KEY=app-4RqmhqdaRo3LvD7FqQiNEtUn
VITE_DIFY_APP_ID=your-app-id

# 后端模式切换：dify（云端）| local（本地 Agent 接口）
# - dify: 使用 Dify 云端 API
# - local: 使用本地 Agent 接口（ai-sdk Data Stream 协议）
VITE_ASSISTANT_BACKEND=local

# 本地 Agent 接口地址（仅 VITE_ASSISTANT_BACKEND=local 时生效）
# 默认值: http://localhost:5688/api/ai/chat/stream
VITE_LOCAL_API_URL=http://localhost:5688/api/ai/chat/stream
